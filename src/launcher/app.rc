#include <windows.h>

// The first icon in the resource table is what Explorer and the taskbar use for the exe.
#define IDI_APPICON 101
IDI_APPICON ICON "hog.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "HOG Fixer launcher"
            VALUE "ProductName", "HOG Fixer"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
